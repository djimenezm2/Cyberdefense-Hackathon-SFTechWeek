flowchart TB
  subgraph Team["Team and their agents"]
    david["David<br>orchestrator + backend sessions"]
    nana["Nana<br>Juice Shop agent"]
    valeria["Valeria<br>dashboard agent"]
  end
  subgraph Repo["Team repo (public)"]
    main["main branch"]
    folders["backend/ · frontend/ · juiceshop/ · docs/"]
    msgs["docs/context/agent-messages.md"]
  end
  fork["Fork djimenezm2/juice-shop<br>submodule juiceshop/juice-shop"]
  subgraph CI["GitHub Actions"]
    wbe["backend-image"]
    wjs["juiceshop-image"]
  end
  ghcr[("GHCR images")]
  akash["Akash<br>api · juiceshop"]
  vercel["Vercel<br>dashboard"]
  cf["Cloudflare DNS + HTTPS"]
  envf["Local .env per teammate<br>secrets never in git"]
  agentfix["Rootlane agent: approved fix"]
  david -- "push / msg" --> main
  nana -- "PR / msg" --> main
  valeria -- "push / msg" --> main
  main --- folders
  main --- msgs
  msgs -. "monitor on origin/main" .-> david
  msgs -. "monitor" .-> nana
  msgs -. "monitor" .-> valeria
  folders -- "submodule" --> fork
  main -- "on push" --> wbe --> ghcr
  main -- "on push" --> wjs --> ghcr
  main -- "on push, frontend/" --> vercel
  ghcr -- "pull image" --> akash
  cf -- "CNAME" --> akash
  cf -- "CNAME" --> vercel
  envf -. "env vars" .-> akash
  agentfix -- "PR rootlane/incident" --> fork
  agentfix -- "new image + deployment update" --> akash
  classDef person fill:#ffffff,stroke:#333333,color:#000000
  classDef repo fill:#dae8fc,stroke:#6c8ebf,color:#000000
  classDef ci fill:#d5e8d4,stroke:#82b366,color:#000000
  classDef run fill:#f5f5f5,stroke:#666666,color:#000000
  classDef secret fill:#f8cecc,stroke:#b85450,color:#000000
  class david,nana,valeria person
  class main,folders,msgs,fork repo
  class wbe,wjs,ghcr ci
  class akash,vercel,cf,agentfix run
